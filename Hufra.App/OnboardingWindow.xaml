<Window x:Class="Hufra.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حُفرة - الإعداد الأولي" Height="620" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FlowDirection="RightToLeft">
    <Grid Background="{StaticResource CreamBackgroundBrush}">
        <!-- الخطوة 1: الديسكورد -->
        <StackPanel x:Name="Step1Panel" VerticalAlignment="Center" Margin="36">
            <Border Width="72" Height="72" CornerRadius="16" ClipToBounds="True" HorizontalAlignment="Center">
                <Image Source="Assets/hufra_logo.png" Stretch="UniformToFill" />
            </Border>
            <TextBlock Text="الخطوة 1 من 2" FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,0"
                       Foreground="{StaticResource BrownPrimaryBrush}" />
            <TextBlock Text="ادخل سيرفر الديسكورد" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{StaticResource BrownDarkestBrush}" Margin="0,4,0,0" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,20" FontSize="13"
                       Foreground="{StaticResource BrownDarkBrush}">
                سيرفر حُفرة فيه الدعم الفني والتحديثات. لازم تدخله قبل ما تستخدم البرنامج: اضغط الزر، وادخل السيرفر، ثم ارجع هنا.
            </TextBlock>
            <Button Content="فتح سيرفر الديسكورد  💬" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center" Padding="24,12" Click="OpenDiscord_Click" />
            <CheckBox x:Name="JoinedCheck" Content="دخلت السيرفر" IsEnabled="False" Margin="0,22,0,0" FontSize="13"
                      HorizontalAlignment="Center" Checked="JoinedCheck_Changed" Unchecked="JoinedCheck_Changed" />
            <Button x:Name="Step1NextButton" Content="التالي ←" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center" Padding="30,10" Margin="0,16,0,0" IsEnabled="False"
                    Click="Step1Next_Click" />
        </StackPanel>

        <!-- الخطوة 2: مفتاح Gemini -->
        <ScrollViewer x:Name="Step2Panel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,24">
                <TextBlock Text="الخطوة 2 من 2" FontSize="12" HorizontalAlignment="Center"
                           Foreground="{StaticResource BrownPrimaryBrush}" />
                <TextBlock Text="أنشئ مفتاح Gemini (مجاني)" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,4,0,0"
                           Foreground="{StaticResource BrownDarkestBrush}" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,14" FontSize="12"
                           Foreground="{StaticResource BrownDarkBrush}">
                    المفتاح يشغّل الذكاء الاصطناعي اللي يفهم طلباتك في بوت الديسكورد. مجاني ويبقى على جهازك فقط. لا يمكن فتح البرنامج بدونه.
                </TextBlock>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="كيف تسويه؟" FontWeight="Bold" Foreground="{StaticResource BrownDarkestBrush}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" LineHeight="22"
                                   Foreground="{StaticResource BrownDarkBrush}">
                            1) اضغط زر «فتح صفحة المفاتيح» تحت.
                            <LineBreak />2) سجّل دخول بحساب Google.
                            <LineBreak />3) اضغط «Create API key» (إنشاء مفتاح).
                            <LineBreak />4) اختر أي مشروع (أو أنشئ مشروع جديد).
                            <LineBreak />5) انسخ المفتاح (يبدأ بـ AIza) والصقه بالمربع تحت.
                            <LineBreak />6) اضغط «تحقق وحفظ». 
                        </TextBlock>
                        <Button Content="فتح صفحة المفاتيح  🔑" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right" Margin="0,12,0,0" Click="OpenGemini_Click" />
                    </StackPanel>
                </Border>

                <TextBlock Text="الصق المفتاح هنا" FontSize="12" Margin="0,16,0,6"
                           Foreground="{StaticResource BrownPrimaryBrush}" />
                <TextBox x:Name="KeyBox" Padding="10,8" FlowDirection="LeftToRight" FontSize="13" />
                <TextBlock x:Name="KeyStatusText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" />
                <Button x:Name="SaveKeyButton" Content="تحقق وحفظ  ✅" Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center" Padding="30,10" Margin="0,16,0,0" Click="SaveKey_Click" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
