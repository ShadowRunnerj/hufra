<Window x:Class="Hufra.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حُفرة - HUFRA" Height="720" Width="1200" MinHeight="560" MinWidth="880"
        Icon="Assets/hufra.ico"
        WindowStartupLocation="CenterScreen">

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="32" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- الشريط الجانبي -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradientBrush}">
            <DockPanel LastChildFill="False">

                <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="0,26,0,18"
                            HorizontalAlignment="Center">
                    <Border Width="84" Height="84" CornerRadius="20" ClipToBounds="True"
                            BorderBrush="#7A4A2A" BorderThickness="1.5">
                        <Image Source="Assets/hufra_logo.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="حُفرة" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource CreamBackgroundBrush}"
                               Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="HUFRA" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentGoldBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="مساعد الديسكورد" FontSize="11"
                               Foreground="{StaticResource BrownLightBrush}"
                               Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavButtonStyle}"
                                 GroupName="Nav" IsChecked="True" Checked="Nav_Checked" Tag="Home">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🏠" FontSize="17" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="الرئيسية" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavDiscord" Style="{StaticResource NavButtonStyle}"
                                 GroupName="Nav" Checked="Nav_Checked" Tag="Discord">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🤖" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="بوت الديسكورد" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButtonStyle}"
                                 GroupName="Nav" Checked="Nav_Checked" Tag="Settings">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚙️" FontSize="17" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="الإعدادات" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavSupport" Style="{StaticResource NavButtonStyle}"
                                 GroupName="Nav" Checked="Nav_Checked" Tag="Support">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ℹ️" FontSize="17" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="الدعم والمعلومات" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <!-- بطاقة الدعم أسفل الشريط -->
                <Border DockPanel.Dock="Bottom" Margin="14,0,14,16" Padding="12" CornerRadius="14"
                        Background="#4A2B18" BorderBrush="#7A4A2A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="💬  الدعم الفني" FontWeight="Bold" FontSize="13"
                                   Foreground="{StaticResource AccentGoldBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="مشكلة؟ اقتراح؟ ادخل الديسكورد" FontSize="11" TextWrapping="Wrap"
                                   TextAlignment="Center" Foreground="{StaticResource BrownLightBrush}"
                                   Margin="0,4,0,8" />
                        <Button Content="دخول الديسكورد" Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="12" Padding="10,6" Click="SidebarDiscord_Click" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- منطقة المحتوى -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- شريط علوي: أيقونة الحساب (أعلى يمين) + عنوان الصفحة الحالية -->
            <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="#E5DDD0" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" x:Name="AvatarButton" Width="36" Height="36" CornerRadius="18"
                            Background="{StaticResource BrownPrimaryBrush}" Cursor="Hand"
                            MouseLeftButtonUp="AvatarButton_Click">
                        <Grid>
                            <TextBlock x:Name="AvatarInitialText" Text="؟" Foreground="White" FontWeight="Bold"
                                       FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="AvatarImage" Stretch="UniformToFill" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" x:Name="UpdateBanner" Visibility="Collapsed" Margin="12,0,0,0"
                            Background="#FFF4DC" BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="12,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UpdateText" Text="🔔 تحديث جديد متوفر!" FontWeight="Bold" FontSize="12"
                                       Foreground="{StaticResource BrownDarkestBrush}" VerticalAlignment="Center" />
                            <Button x:Name="UpdateButton" Content="تحديث الآن" Margin="10,0,0,0" Padding="10,3"
                                    Style="{StaticResource PrimaryButtonStyle}" FontSize="12" Click="UpdateNow_Click" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="2" x:Name="PageTitleText" Text="الرئيسية" FontWeight="Bold" FontSize="15"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{StaticResource BrownDarkestBrush}" />
                </Grid>
            </Border>

            <!-- لوحة الملف الشخصي المنبثقة -->
            <Popup x:Name="ProfilePopup" PlacementTarget="{Binding ElementName=AvatarButton}"
                   Placement="Bottom" StaysOpen="False" HorizontalOffset="0" VerticalOffset="6">
                <Border Background="White" CornerRadius="12" Padding="18" Width="300"
                        BorderBrush="#E5DDD0" BorderThickness="1">
                    <StackPanel FlowDirection="RightToLeft">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="52" Height="52" CornerRadius="26" Cursor="Hand"
                                    Background="{StaticResource BrownPrimaryBrush}"
                                    MouseLeftButtonUp="ChangeAvatar_Click">
                                <Grid>
                                    <TextBlock x:Name="PopupAvatarInitialText" Text="؟" Foreground="White"
                                               FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image x:Name="PopupAvatarImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBox x:Name="ProfileNameBox" Width="180" Padding="6,4"
                                         FlowDirection="RightToLeft" />
                                <TextBlock Text="اضغط الصورة لتغييرها" FontSize="10" Margin="2,4,0,0"
                                           Foreground="{StaticResource BrownPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Button Content="حفظ" Style="{StaticResource PrimaryButtonStyle}" Padding="10,6"
                                Margin="0,12,0,0" HorizontalAlignment="Right" Click="SaveProfile_Click" />

                        <Border Height="1" Background="#E5DDD0" Margin="0,14,0,10" />

                        <TextBlock Text="الألعاب اللي عرّبتها" FontWeight="Bold" FontSize="13"
                                   Foreground="{StaticResource BrownDarkestBrush}" />
                        <ListBox x:Name="HistoryListBox" MaxHeight="180" BorderThickness="0"
                                 Margin="0,8,0,0" Background="Transparent" />
                    </StackPanel>
                </Border>
            </Popup>

            <ContentControl x:Name="MainContent" Grid.Row="1" Margin="24" />
        </Grid>
      </Grid>

      <!-- شريط الحالة -->
      <Border Grid.Row="1" Background="#2E1B10">
        <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="#5BC06A" Margin="0,0,8,0" />
                <TextBlock Text="جاهز للعمل" FontSize="12" Foreground="#E8DFD3" />
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="ProviderStatusText" FontSize="11" Foreground="{StaticResource BrownLightBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" x:Name="VersionText" Text="النسخة: 2.6.2   |   اللغة: العربية"
                       FontSize="11" Foreground="{StaticResource BrownLightBrush}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
</Window>
